{
  "name": "spider-guia",
  "private": true,
  "version": "6.1.0",
  "description": "SPIDER·GUIA privado com Vite + TypeScript + Preact, dados em chunks por fase, progresso e testes.",
  "type": "module",
  "scripts": {
    "dev": "npm run data:build && vite",
    "build": "npm run data:build && npm run typecheck && vite build && node scripts/build-deployment-manifest.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "format": "prettier --write \"{src,scripts,data,tests}/**/*.{ts,tsx,mjs,json,md}\" \"*.{html,json,md,mjs,ts}\" \".github/workflows/*.yml\" public/*.js",
    "format:check": "prettier --check \"{src,scripts,data,tests}/**/*.{ts,tsx,mjs,json,md}\" \"*.{html,json,md,mjs,ts}\" \".github/workflows/*.yml\" public/*.js",
    "lint": "eslint \"public/**/*.js\" \"scripts/**/*.mjs\" \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\" \"*.config.ts\" \"vite.config.mjs\"",
    "data:build": "node scripts/build-data.mjs",
    "data:check": "node scripts/build-data.mjs --check && node scripts/check-id-snapshot.mjs && node scripts/check-catalog-snapshot.mjs && node scripts/simulate-progress-migration.mjs && node scripts/check-editorial-consolidation.mjs && node scripts/verify-legacy-migration.mjs && node scripts/check-runtime-data.mjs && npm run extras:confirmation:check",
    "data:ids": "node scripts/check-id-snapshot.mjs",
    "data:legacy:verify": "node scripts/verify-legacy-migration.mjs",
    "data:progress:compat": "node scripts/simulate-progress-migration.mjs",
    "data:catalog": "node scripts/check-catalog-snapshot.mjs",
    "links:check": "node scripts/check-editorial-links.mjs && node scripts/check-link-integrity.mjs",
    "data:runtime:check": "node scripts/check-runtime-data.mjs",
    "spoilers:explicit:check": "node scripts/migrate-explicit-spoilers.mjs --check",
    "spoilers:suggest": "node scripts/suggest-spoilers.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:pages": "playwright test --config playwright.pages.config.ts",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "e:unit": "vitest run",
    "e:e2e": "playwright test",
    "e:check": "npm run typecheck && npm run lint && npm run architecture:check && npm run icons:check && npm run design:check && npm run storage:compat && npm run navigation:check && npm run reading-sequence:check && npm run read-through:check && npm run data:check && npm run links:check && npm run spoilers:check && npm run spoilers:explicit:check && npm run test:unit",
    "ci": "npm run data:generated:check && npm run e:check && npm run build",
    "extras:confirmation:check": "node scripts/check-extra-confirmation.mjs",
    "reset:smoke": "node scripts/smoke-reset-stage4.mjs",
    "reset:local-smoke": "node scripts/smoke-local-reset-stage4.mjs",
    "focus:navigation:check": "node --experimental-strip-types scripts/check-focus-navigation.mjs",
    "reading-sequence:check": "node --experimental-strip-types scripts/check-reading-sequence-refactor.mjs",
    "icons:check": "node scripts/check-lucide-icons.mjs",
    "storage:compat": "node scripts/simulate-b-storage-migration.mjs",
    "router:check": "node scripts/check-router-contract.mjs",
    "spoilers:check": "node scripts/check-d-spoilers.mjs",
    "design:check": "node scripts/check-design-system.mjs",
    "architecture:check": "node scripts/check-module-boundaries.mjs && node scripts/check-e-quality.mjs",
    "data:generated:check": "node scripts/check-generated-data.mjs",
    "navigation:check": "npm run router:check && node scripts/check-explore-targets.mjs && node scripts/check-help-routing.mjs && npm run focus:navigation:check",
    "read-through:check": "node scripts/check-read-through.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.1",
    "eslint": "^9.0.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "yaml": "2.9.1",
    "zod": "^4.6.7"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "lucide-preact": "^1.59.0",
    "preact": "^11.0.1"
  }
}
